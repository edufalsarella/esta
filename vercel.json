{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["gru1"],
  "functions": {
    "api/gerar-nfse.js": { "includeFiles": "src/servidor/xsd/**" }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
